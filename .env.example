# =============================================================================
# AI Meme Coin Terminal — environment config
# Copy this file to `.env` and fill in values before running the backend.
# =============================================================================

# --- Solana / market data ---
HELIUS_API_KEY=
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=
BIRDEYE_API_KEY=
RUGCHECK_JWT=
GMGN_SESSION_COOKIE=
CIELO_API_KEY=

# --- Social / news ---
TWITTER_BEARER_TOKEN=
TWITTER_SCRAPE_ACCOUNTS=
NEWSAPI_KEY=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
OLLAMA_URL=http://host.docker.internal:11434

# --- Infrastructure ---
POSTGRES_URL=postgresql+asyncpg://memeterm:memeterm@127.0.0.1:5432/memeterm
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_URL=http://127.0.0.1:8001

# --- App ---
# Paste your Phantom pubkey (public, read-only) once the UI is live.
PHANTOM_PUBKEY=

# Hard daily ceiling for paid LLM spend (USD).
DAILY_AI_BUDGET_USD=15.00

# Auto-generated on first boot; frontend uses this for REST + WS auth.
APP_BEARER_TOKEN=

# Logging
LOG_LEVEL=INFO

# HTTP bind
API_HOST=127.0.0.1
API_PORT=8787
